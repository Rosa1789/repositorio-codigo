---  CONTROL COMPARA CANTIDAD DE MOVIMIENTOS PRODUCTO 1 CON 11 (CCICO - CCICOBC)
SELECT  P.ID_MAE_PERSONA, 
        P.RUT_MAE_PERSONA, 
        P.DV_MAE_PERSONA, 
        NO.ID_TIPPRODUCTO, 
        RT.ID_TIP_PRODUCTO, 
        COUNT(NO.ID_MAEMOVIMIENTO) CONTAR_MOV_CCICON, 
        COUNT(RT.ID_MAE_MOVIMIENTO) CONTAR_MOV_CCICO,
        'HAY DIFERENCIAS DE CONTAR MOVIMIENTOS ENTRE PRODUTO CCICO Y CCICON' AS ERROR
FROM  CUENTAS.TB_MAE_PERSONA P, 
      OWN_NOCIONAL.TN_MAEMOVIMIENTOBC NO,  
      CUENTAS.TB_MAE_MOVIMIENTO RT
      
WHERE P.ID_MAE_PERSONA = NO.ID_MAEPERSONA
      AND P.ID_MAE_PERSONA = RT.ID_MAE_PERSONA
      AND NO.FECH_ACREDITACION BETWEEN TO_DATE (?, 'DD-MM-YYYY')AND TO_DATE (?, 'DD-MM-YYYY')              ------> FECHA DEL MES 
      AND RT.FEC_ACREDITACION  BETWEEN TO_DATE (?, 'DD-MM-YYYY')AND TO_DATE (?, 'DD-MM-YYYY')              ------> FECHA DEL MES 
      AND NO.ID_TIPPRODUCTO = 11
      AND RT.ID_TIP_PRODUCTO = 1
      
GROUP BY  P.ID_MAE_PERSONA, 
          P.RUT_MAE_PERSONA, 
          P.DV_MAE_PERSONA,  
          NO.ID_TIPPRODUCTO, 
          RT.ID_TIP_PRODUCTO
          
HAVING COUNT(NO.ID_MAEMOVIMIENTO) <> COUNT(RT.ID_MAE_MOVIMIENTO)


---  CONTROL COMPARA CANTIDAD DE MOVIMIENTOS PRODUCTO 6 CON 12 (CCIAV - CCIAVBC)
UNION ALL

SELECT  P.ID_MAE_PERSONA, 
        P.RUT_MAE_PERSONA, 
        P.DV_MAE_PERSONA, 
        NO.ID_TIPPRODUCTO, 
        RT.ID_TIP_PRODUCTO, 
        COUNT(NO.ID_MAEMOVIMIENTO) CONTAR_MOV_CCIAVN, 
        COUNT(RT.ID_MAE_MOVIMIENTO) CONTAR_MOV_CCIAV,
        'HAY DIFERENCIAS DE CONTAR MOVIMIENTOS ENTRE PRODUTO CCIAV Y CCIAVN' AS ERROR
FROM  CUENTAS.TB_MAE_PERSONA P, 
      OWN_NOCIONAL.TN_MAEMOVIMIENTOBC NO,  
      CUENTAS.TB_MAE_MOVIMIENTO RT
WHERE P.ID_MAE_PERSONA = NO.ID_MAEPERSONA
      AND P.ID_MAE_PERSONA = RT.ID_MAE_PERSONA
      AND NO.FECH_ACREDITACION BETWEEN TO_DATE (?, 'DD-MM-YYYY')AND TO_DATE (?, 'DD-MM-YYYY')              ------> FECHA DEL MES 
      AND RT.FEC_ACREDITACION  BETWEEN TO_DATE (?, 'DD-MM-YYYY')AND TO_DATE (?, 'DD-MM-YYYY')              ------> FECHA DEL MES 
      AND NO.ID_TIPPRODUCTO = 12
      AND RT.ID_TIP_PRODUCTO = 6
GROUP BY  P.ID_MAE_PERSONA, 
          P.RUT_MAE_PERSONA, 
          P.DV_MAE_PERSONA,  
          NO.ID_TIPPRODUCTO, 
          RT.ID_TIP_PRODUCTO
HAVING COUNT(NO.ID_MAEMOVIMIENTO) <> COUNT(RT.ID_MAE_MOVIMIENTO)
