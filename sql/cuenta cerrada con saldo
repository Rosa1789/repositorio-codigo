SELECT DISTINCT B.RUT_MAE_PERSONA, 
                B.DV_MAE_PERSONA, 
                A.ID_TIPPRODUCTO, 
                A.ID_TIPFONDO, 
                A.INDC_ESTADO, 
                A.VLOR_SALDOCUOTACONTROL, 
                A.ID_MAECUENTA, A.NMRO_CUENTA,--------------------A.IND_ACREDITABLE, B.ID_MAE_PERSONA, 
                'CUENTAS NO VIGENTES CON SALDO MAYOR A 0' AS ERROR
                -----D.ID_TIP_ROL, E.DES_TIP_ROL, D.ID_TIP_ESTADO_ROL, F.DES_TIP_ESTADO_ROL, C.IND_ESTADO
FROM  OWN_NOCIONAL.TN_MAECUENTABC A, 
      TB_MAE_PERSONA B, 
      TB_PERSONA_ROL C, 
      TB_ROL_EST_ATR D, 
      TB_TIP_ROL E, 
      TB_TIP_ESTADO_ROL F
      
WHERE A.ID_MAEPERSONA=B.ID_MAE_PERSONA 
      AND B.ID_MAE_PERSONA=C.ID_MAE_PERSONA 
      AND C.ID_ROL_EST_ATR=D.ID_ROL_EST_ATR 
      AND E.ID_TIP_ROL=D.ID_TIP_ROL 
      AND D.ID_TIP_ESTADO_ROL=F.ID_TIP_ESTADO_ROL
      AND A.INDC_ESTADO=0 
      AND A.VLOR_SALDOCUOTACONTROL>0 
      AND C.IND_ESTADO=1 
      AND D.ID_TIP_ROL IN (1 , 7, 12) -----------------------> 1=AFILIADO, 7:CLIENTE, 12=TITULAR CAV
