SELECT  P.RUT_MAE_PERSONA, 
        P.DV_MAE_PERSONA, 
        M.ID_MAEMOVIMIENTO, 
        M.ID_CODPROCESO, 
        M.ID_TIPPRODUCTO, 
        M.FECH_MOVIMIENTO, 
        T.IND_TIPO,
        M.FECH_ACREDITACION, 
        M.FECH_PERCOT, 
        M.NRUT_PAGADOR, 
        M.ID_TIPMOVIMIENTO, 
        T.DES_LARGA,
        'PERIODO COTIZADO MAYOR A FECHA DE ACREDITACION' AS ERROR
        
FROM  CUENTAS.TB_MAE_PERSONA P, 
      OWN_NOCIONAL.TN_MAEMOVIMIENTOBC M, 
      CUENTAS.TB_TIP_MOVIMIENTO T
      
WHERE P.ID_MAE_PERSONA = M.ID_MAEPERSONA 
      AND M.ID_TIPMOVIMIENTO = T.ID_TIP_MOVIMIENTO
      AND M.FECH_PERCOT > M.FECH_ACREDITACION  ------>PERIODO COTIZADO NO PUEDE SER MAYOR A FECHA DE ACREDITACION
