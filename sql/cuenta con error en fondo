SELECT  R.RUT_MAE_PERSONA, 
        R.DV_MAE_PERSONA, 
        B.ID_MAEPERSONA, 
        B.ID_MAECUENTA, 
        B.ID_TIPPRODUCTO, 
        B.ID_TIPFONDO, 
        B.INDC_ESTADO,
        B.VLOR_SALDOCUOTACONTROL, 
        B.INDC_ACREDITABLE, 
        'TIENE 2 FONDOS ACREDITABLES' AS ERROR
        
FROM OWN_NOCIONAL.TN_MAECUENTABC B, 
     (SELECT  A.ID_MAE_PERSONA, 
              A.RUT_MAE_PERSONA, 
              A.DV_MAE_PERSONA, 
              B.ID_TIPPRODUCTO, 
              SUM( B.INDC_ACREDITABLE)
      FROM  TB_MAE_PERSONA A, 
            OWN_NOCIONAL.TN_MAECUENTABC B
      WHERE A.ID_MAE_PERSONA = B.ID_MAEPERSONA
            AND B.INDC_ESTADO = 1
            AND B.INDC_ACREDITABLE=1
      GROUP BY  A.ID_MAE_PERSONA,
                B.ID_TIPPRODUCTO, 
                A.RUT_MAE_PERSONA, 
                A.DV_MAE_PERSONA
      HAVING SUM ( B.INDC_ACREDITABLE) > 1) R

WHERE B.ID_MAEPERSONA = R.ID_MAE_PERSONA
      AND B.ID_TIPPRODUCTO = R.ID_TIPPRODUCTO
      AND B.INDC_ESTADO = 1
      AND B.INDC_ACREDITABLE = 1
--ORDER BY R.RUT_MAE_PERSONA ASC

-----------------------------------------------------------
----BUSCA CUENTAS CON 3 FONDOS VIGENTES------
----PARA UN MISMO TIPO DE CUENTA---------------------------
-----------------------------------------------------------
UNION ALL

SELECT  R.RUT_MAE_PERSONA, 
        R.DV_MAE_PERSONA, 
        R.ID_MAE_PERSONA, 
        C.ID_MAECUENTA, 
        C.ID_TIPPRODUCTO, 
        C.ID_TIPFONDO, 
        C.INDC_ESTADO, 
        C.VLOR_SALDOCUOTACONTROL, 
        C.INDC_ACREDITABLE, 
        'TIENE 3 O MAS FONDOS VIGENTE' AS ERROR
FROM OWN_NOCIONAL.TN_MAECUENTABC C,
     (SELECT  P.ID_MAE_PERSONA, 
              P.RUT_MAE_PERSONA, 
              P.DV_MAE_PERSONA, 
              C.ID_TIPPRODUCTO, 
              COUNT (C.ID_TIPFONDO)
      FROM  TB_MAE_PERSONA P, 
            OWN_NOCIONAL.TN_MAECUENTABC C
      WHERE P.ID_MAE_PERSONA=C.ID_MAEPERSONA
            AND C.INDC_ESTADO=1
      GROUP BY  P.ID_MAE_PERSONA, 
                P.RUT_MAE_PERSONA, 
                P.DV_MAE_PERSONA, 
                C.ID_TIPPRODUCTO
      HAVING COUNT (C.ID_TIPFONDO)> 2) R
      
WHERE C.ID_MAEPERSONA=R.ID_MAE_PERSONA
      AND C.ID_TIPPRODUCTO = R.ID_TIPPRODUCTO
      AND C.INDC_ESTADO=1

------------------------------------------------------------------------
------ OBTIENE DETALLE DE CUENTAS SIN MARCA FONDO ACREDITABLE ----------
------------------------------------------------------------------------
UNION ALL

SELECT  R.RUT_MAE_PERSONA, 
        R.DV_MAE_PERSONA, 
        B.ID_MAEPERSONA, 
        B.ID_MAECUENTA, 
        B.ID_TIPPRODUCTO, 
        B.ID_TIPFONDO, 
        B.INDC_ESTADO, 
        B.VLOR_SALDOCUOTACONTROL,
        B.INDC_ACREDITABLE, 
        'SIN MARCA FONDO ACREDITABLE' AS ERROR
FROM OWN_NOCIONAL.TN_MAECUENTABC B,
     (SELECT A.ID_MAE_PERSONA, 
             A.RUT_MAE_PERSONA, 
             A.DV_MAE_PERSONA, 
             B.ID_TIPPRODUCTO, 
             SUM( B.INDC_ACREDITABLE)
      FROM TB_MAE_PERSONA A, OWN_NOCIONAL.TN_MAECUENTABC B
      WHERE A.ID_MAE_PERSONA = B.ID_MAEPERSONA
            AND B.INDC_ESTADO = 1
      GROUP BY  A.ID_MAE_PERSONA, 
                B.ID_TIPPRODUCTO, 
                A.RUT_MAE_PERSONA, 
                A.DV_MAE_PERSONA
      HAVING SUM( B.INDC_ACREDITABLE) = 0) R
      
WHERE B.ID_MAEPERSONA = R.ID_MAE_PERSONA
      AND B.ID_TIPPRODUCTO = R.ID_TIPPRODUCTO
      AND B.INDC_ESTADO = 1

---------------------------------------------------------
------------CUENTAS VIGENTES SIN FONDO-------------------
---------------------------------------------------------
UNION ALL

SELECT  A.RUT_MAE_PERSONA, 
        A.DV_MAE_PERSONA, 
        B.ID_MAEPERSONA, 
        B.ID_MAECUENTA, 
        B.ID_TIPPRODUCTO, 
        B.ID_TIPFONDO, 
        B.INDC_ESTADO, 
        B.VLOR_SALDOCUOTACONTROL, 
        B.INDC_ACREDITABLE, 
        'CUENTA VIGENTE SIN FONDO' AS ERROR
        ---B.NRO_CUENTA, B.FEC_CREACION, O.ID_TIP_ORIGEN_CTA, O.DES_TIP_ORIGEN_CTA, B.AUD_CREADO_POR
FROM  TB_MAE_PERSONA A, 
      OWN_NOCIONAL.TN_MAECUENTABC B, 
      TB_TIP_ORIGEN_CTA O
WHERE A.ID_MAE_PERSONA=B.ID_MAEPERSONA
      AND B.ID_TIPORIGENCTA=O.ID_TIP_ORIGEN_CTA
      AND B.INDC_ESTADO=1
      AND B.ID_TIPFONDO=0
