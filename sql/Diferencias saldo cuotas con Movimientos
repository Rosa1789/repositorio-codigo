SELECT  Y.RUT_MAE_PERSONA, 
        Y.DV_MAE_PERSONA, 
        Y.ID_MAE_PERSONA,
        y.ID_TIPFONDO,
        X.ID_TIPPRODUCTO, 
        X.VLOR_SALDOCUOTACONTROL, 
        Y.CUOTAS_MOVIMIENTOS
FROM (SELECT  A.ID_MAEPERSONA, 
              A.ID_TIPPRODUCTO,
              A.ID_TIPFONDO,
              SUM(A.VLOR_SALDOCUOTACONTROL) AS VLOR_SALDOCUOTACONTROL
      FROM OWN_NOCIONAL.TN_MAECUENTABC A
      ---WHERE A.ID_MAEPERSONA = 7676976
      GROUP BY A.ID_MAEPERSONA, A.ID_TIPPRODUCTO,A.ID_TIPFONDO
      ) X ,

      (SELECT P.RUT_MAE_PERSONA, 
              P.DV_MAE_PERSONA, 
              P.ID_MAE_PERSONA, 
              M.ID_TIPPRODUCTO,
              M.ID_TIPFONDO,
              CASE WHEN(  NVL(SUM(CASE WHEN T.INDC_TIPO=1 THEN M. MNTO_CUOTAS END),0) - NVL(SUM(CASE WHEN T.INDC_TIPO=0 THEN M. MNTO_CUOTAS END),0) ) <0 THEN 0 
              ELSE NVL(SUM(CASE WHEN T.INDC_TIPO=1 THEN M. MNTO_CUOTAS END),0) - NVL(SUM(CASE WHEN T.INDC_TIPO=0 THEN M. MNTO_CUOTAS END),0) END AS CUOTAS_MOVIMIENTOS
      FROM  CUENTAS.TB_MAE_PERSONA P, 
            OWN_NOCIONAL.TN_MAEMOVIMIENTOBC M LEFT JOIN OWN_NOCIONAL.TN_TIPMOVIMIENTOBC T ON  M.ID_TIPMOVIMIENTO=T.ID_TIPMOVIMIENTO
      WHERE P.ID_MAE_PERSONA=M. ID_MAEPERSONA
      --AND P.RUT_MAE_PERSONA = 7682665
      GROUP BY P.RUT_MAE_PERSONA, P.DV_MAE_PERSONA, P.ID_MAE_PERSONA, M.ID_TIPPRODUCTO, M.ID_TIPFONDO
      ) Y

WHERE X.ID_MAEPERSONA = Y.ID_MAE_PERSONA
      AND X.ID_TIPPRODUCTO = Y.ID_TIPPRODUCTO
      AND X.VLOR_SALDOCUOTACONTROL <> Y.CUOTAS_MOVIMIENTOS
      AND X.ID_TIPFONDO = Y.ID_TIPFONDO
AND X.ID_MAEPERSONA NOT IN (13681319)
