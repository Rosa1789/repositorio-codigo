SELECT  A.ID_MAECUENTA, 
        A.ID_MAEPERSONA, 
        A.ID_TIPPRODUCTO, 
        A.ID_TIPFONDO, 
        A.FECH_CREACION, 
        A.NMRO_CUENTA, 
        A.INDC_ESTADO,  
        A.VLOR_SALDOCUOTACONTROL, 
        'SIN ID_MAEPERSONA EN TABLA OWN_NOCIONAL.TN_MAECUENTABC' AS ERROR
FROM OWN_NOCIONAL.TN_MAECUENTABC A
WHERE A.INDC_ESTADO=1
      AND A.ID_MAEPERSONA IN (0, NULL)

UNION ALL
--------------------------------------------------------------
------EXISTE EN OWN_NOCIONAL.TN_MAECUENTANOC NO EN TB_MAE_PERSONA-----------
-------------------------------------------------------------
SELECT  A.ID_MAECUENTA, 
        A.ID_MAEPERSONA, 
        A.ID_TIPPRODUCTO, 
        A.ID_TIPFONDO, 
        A.FECH_CREACION, 
        A.NMRO_CUENTA, 
        A.INDC_ESTADO, 
        A.VLOR_SALDOCUOTACONTROL, 
        'EXISTE EN OWN_NOCIONAL.TN_MAECUENTABC Y NO EN TB_MAE_PERSONA' AS ERROR 
FROM OWN_NOCIONAL.TN_MAECUENTABC A
WHERE A.INDC_ESTADO=1
      AND NOT EXISTS (  SELECT 1
                        FROM TB_MAE_PERSONA B
                        WHERE B.ID_MAE_PERSONA = A.ID_MAEPERSONA)
