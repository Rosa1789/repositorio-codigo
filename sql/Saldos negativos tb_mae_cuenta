SELECT  A.RUT_MAE_PERSONA, 
        A.DV_MAE_PERSONA, 
        B.ID_MAECUENTA, 
        B.ID_MAEPERSONA, 
        B.VLOR_SALDOCUOTACONTROL,
        'SALDOS NEGATIVOS O VALOR NULO EN TB_MAE_CUENTA' AS ERROR
        
FROM  TB_MAE_PERSONA A, 
      OWN_NOCIONAL.TN_MAECUENTABC B
      
WHERE A.ID_MAE_PERSONA=B.ID_MAEPERSONA
      AND B.INDC_ESTADO = 1
      AND (B.VLOR_SALDOCUOTACONTROL < 0 OR B.VLOR_SALDOCUOTACONTROL IS NULL)
