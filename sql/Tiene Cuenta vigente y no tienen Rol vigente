SELECT  COUNT (C.ID_MAECUENTA)AS CONTAR, 
        P.ID_MAE_PERSONA, 
        P.RUT_MAE_PERSONA, 
        P.DV_MAE_PERSONA, 
        C.INDC_ESTADO, 
        C.ID_TIPPRODUCTO,
        SUM(C.VLOR_SALDOCUOTACONTROL) AS VLOR_SALDOCUOTACONTROL, 
        SUM(R.IND_ESTADO) AS IND_ESTADO_PERSONA_ROL,
        'TIENEN CUENTA VIGENTE Y NO TIENEN ROL' AS ERROR
FROM  OWN_NOCIONAL.TN_MAECUENTABC C, 
      CUENTAS.TB_MAE_PERSONA P, 
      CUENTAS.TB_PERSONA_ROL R, 
      CUENTAS.TB_ROL_EST_ATR A
WHERE C.ID_MAEPERSONA=P.ID_MAE_PERSONA
      AND P.ID_MAE_PERSONA=R.ID_MAE_PERSONA
      AND R.ID_ROL_EST_ATR=A.ID_ROL_EST_ATR
      AND C.INDC_ESTADO=1
      AND A.ID_ROL_EST_ATR IN (1, 5, 8, 24, 26, 27, 28,30)
GROUP BY  P.ID_MAE_PERSONA, 
          P.RUT_MAE_PERSONA, 
          P.DV_MAE_PERSONA, 
          C.INDC_ESTADO, 
          C.ID_TIPPRODUCTO
HAVING SUM(R.IND_ESTADO)  = 0
